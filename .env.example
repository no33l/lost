# Kopiere diese Datei nach .env und fülle die Werte.

# SQLite im Dev-Betrieb. Für PostgreSQL: provider in prisma/schema.prisma auf
# "postgresql" stellen und hier z. B. postgresql://user:pass@localhost:5432/lost eintragen.
DATABASE_URL="file:./dev.db"

# 32 Bytes als Hex (64 Zeichen). Verschlüsselt hochgeladene Dokumente (AES-256-GCM)
# und die TOTP-Secrets in der Datenbank. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="ersetze-mich-64-hex-zeichen"

# Basis-URL der App (für Links, otpauth-Issuer etc.)
APP_URL="http://localhost:3000"

# Local testing only: set to "true" to skip mandatory 2FA for advisors/admins.
# Never enable this in production.
# DISABLE_2FA_REQUIREMENT=true
